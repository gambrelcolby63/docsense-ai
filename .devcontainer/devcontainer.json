{
  "name": "DocSense AI",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "DocSense web",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "DocSense API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -r api/requirements.txt -r api/requirements-dev.txt && npm ci --prefix web",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
