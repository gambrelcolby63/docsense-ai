# Copy to .env in the repo root. The API reads either this file or real
# environment variables. Docker Compose ignores this file on purpose and
# forces the mock provider so the demo runs without a key.

# --- Database ---
# SQLite file (created automatically). The path is relative to the API process.
DATABASE_URL=sqlite:///./data/docsense.db

# Postgres (Render, Fly, or local). The driver is installed; no code change required.
# DATABASE_URL=postgresql+psycopg://docsense:docsense@localhost:5432/docsense

# --- Language model ---
# auto: mock when OPENAI_API_KEY is empty, otherwise the OpenAI-compatible API.
# mock: never call the network. openai: require a key.
LLM_PROVIDER=auto

# Chat can be remote while embeddings stay local. Groq and many free
# OpenRouter models have no embeddings endpoint, so "local" is the safe default.
# auto: local for the mock provider, remote when a key is set (falls back to local).
# local: hashed token embeddings on this machine. openai: POST /embeddings.
EMBEDDING_PROVIDER=local

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq (free tier, chat only — keep EMBEDDING_PROVIDER=local):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_...

# OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.2-3b-instruct:free
# OPENAI_API_KEY=sk-or-...

# Ollama on your machine:
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=ollama
# OPENAI_EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_PROVIDER=openai

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Web (baked into the Next.js bundle at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional tuning
# MAX_UPLOAD_BYTES=15728640
# CHUNK_SIZE=700
# CHUNK_OVERLAP=100
# RETRIEVAL_K=4
